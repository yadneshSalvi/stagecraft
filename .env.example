# Copy to .env.local. Keep actual credentials server-side and untracked.
# The app and migration script load Next.js environment files from this project.
DATABASE_URL=postgresql://postgres:password@localhost:5432/stagecraft_dev
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID may be used with the deployment's Vercel OIDC token instead.
BLOB_STORE_ID=

OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL_OPENAI=gpt-6-astra
AI_MODEL_GEMINI=gemini-4-argon

YOUCAM_API_KEY=
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
YOUCAM_API_KEY_EXPIRES_AT=
YOUCAM_DAILY_JOB_LIMIT=16
YOUCAM_OWNER_DAILY_JOB_LIMIT=4
YOUCAM_REQUEST_LIMIT_PER_5_MIN=40
GENERATION_PAUSED=false

# Optional local integration tests. Only localhost stagecraft_dev/stagecraft_test
# databases are accepted. Provider and Blob calls are mocked in those tests.
TEST_DATABASE_URL=

# Workflow selects its local development world and the deployed Vercel world
# automatically. Do not set WORKFLOW_TARGET_WORLD=vercel.
# The legacy YOUCAM_SECRET_KEY, DEEPGRAM_API_KEY and skin analysis settings from
# older workspace credentials are not required by this application.
